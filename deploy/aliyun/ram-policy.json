{
  "Version": "1",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "oss:GetObject",
        "oss:PutObject",
        "oss:DeleteObject"
      ],
      "Resource": [
        "acs:oss:*:*:yryhx-talent-private-cn-shanghai/*",
        "acs:oss:*:*:yryhx-talent-public-cn-shanghai/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "oss:ListObjects"
      ],
      "Resource": [
        "acs:oss:*:*:yryhx-talent-private-cn-shanghai",
        "acs:oss:*:*:yryhx-talent-public-cn-shanghai"
      ]
    }
  ]
}
